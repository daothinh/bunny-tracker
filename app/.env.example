# Local development database URL. Docker Compose overrides this inside the app container.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/bunny_tracker?schema=public

# Required secrets for login and session encryption.
MANAGEMENT_KEY=change-this-management-key
SESSION_SECRET=change-this-session-secret

# Optional GitHub API token to reduce rate limits.
GITHUB_TOKEN=

# Optional CSV overrides. Leave blank to use built-in defaults.
# GITHUB_TOPICS: allowlist topic web3 (dung de gan scope WEB3 vs GENERAL).
# GITHUB_SEARCH_QUERIES: mac dinh gom ca query web3 lan general (phan con lai).
# Moi repo qualify van bat buoc phai co file SECURITY.
GITHUB_TOPICS=
GITHUB_SEARCH_QUERIES=

# Runtime tuning.
MAX_REPOS_PER_RUN=18
SEARCH_RESULTS_PER_QUERY=8
INGEST_INTERVAL_MINUTES=360
APP_BASE_URL=http://localhost:3000
